    "@angular/platform-browser-dynamic": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@semantic-components/re-captcha": "^0.26.0",
    "@tinymce/tinymce-angular": "^8.0.1",
    "ngx-captcha": "^13.0.0",
    "ngx-cookie-service": "^20",
