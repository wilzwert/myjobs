    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "babel-loader": "^9.2.1",
    "babel-plugin-istanbul": "^7.0.0",
    "cypress": "^14.3.0",
    "dotenv": "^16.5.0",
    "dotenv-webpack": "^8.1.0",
    "eslint": "^9.24.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.1.0",
    "jest-marbles": "^3.1.0",
