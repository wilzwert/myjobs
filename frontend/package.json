    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "babel-loader": "^10.0.0",
    "babel-plugin-istanbul": "^7.0.1",
    "cypress": "^15.9.0",
    "dotenv": "^17.2.3",
    "dotenv-webpack": "^8.1.1",
    "eslint": "^9.39.2",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^30.2.0",
    "jest-html-reporter": "^4.3.0",
    "jest-marbles": "^3.1.1",
    "jest-preset-angular": "16.0.0",
