{
  "name": "myjobs",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:ci": "ng run myjobs:e2e-ci",
    "e2e:staging": "ng run myjobs:e2e-ci --record --key 711387bb-9364-433c-83ba-ca040c440282",
    "e2e:coverage": "npx nyc report --report-dir=coverage/e2e --reporter=lcov --reporter=text-summary",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run-record": "cypress run --record --key 711387bb-9364-433c-83ba-ca040c440282",
    "test-full": "node scripts/testfull.js",
    "merge-coverage": "node scripts/merge-coverage.js"
  },
  "nyc": {
    "report-dir": "coverage/e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.0",
    "@angular/cdk": "^21.1.0",
    "@angular/common": "^21.1.0",
